            {"conditions": {"options": {"caseSensitive": true, "typeValidation": "strict"}, "conditions": [{"leftValue": "={{ $json.classification }}", "rightValue": "UNSUBSCRIBE", "operator": {"type": "string", "operation": "equals"}}]}, "renameOutput": true, "outputKey": "UNSUBSCRIBE"},
